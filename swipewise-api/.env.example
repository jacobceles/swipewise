# Credentials for the publish CLI (`npm run publish:catalog`). Copy to `.env`
# and fill in. These are R2's S3-compatible API credentials — create an R2 API
# token in the Cloudflare dashboard (R2 > Manage R2 API Tokens > Object
# Read & Write). The Worker does NOT use these; it reads R2 via its binding.

# Cloudflare account id (R2 > Overview, or the dashboard URL).
R2_ACCOUNT_ID=your-account-id

# R2 API token (S3 credentials) with read+write on the bucket below.
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# Bucket the catalog + card art are published to (matches wrangler.toml).
R2_BUCKET=swipewise-assets

# Base URL the app loads card art from = the deployed Worker (the bucket is
# PRIVATE; the Worker serves /cards/* from its R2 binding). The publish CLI
# rewrites each card's image_url to `${IMAGE_BASE_URL}/cards/<id>.<ext>`.
# It's the Worker URL (not an R2 URL); in CI it's kept as a secret so the
# endpoint stays out of public Action logs.
IMAGE_BASE_URL=https://swipewise-api.your-subdomain.workers.dev
