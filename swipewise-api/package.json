{
  "name": "swipewise-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SwipeWise catalog distribution: a Cloudflare Worker read API over R2, plus a publish CLI that uploads a catalog build + card art to R2.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "publish:catalog": "tsx scripts/publish.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
