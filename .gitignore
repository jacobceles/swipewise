# Android Platform Specifics
android/app/src/main/res/generated/
android/key.properties
android/local.properties
releases/*.apk

# Local-only, Tools & Logs
# Glob, not `keys.json`: the free/Pro split adds keys.free.json and
# keys.pro.json, and the Pro one carries the Sophtron credentials. Committing
# it once is unrecoverable — the value stays in the git objects forever.
keys*.json
!keys.example.json
# keys.free.json is COMMITTED on purpose. Since Places moved behind the Worker
# it holds no credential — only two URLs that are already baked into every
# published APK. Keeping it as a CI secret meant a second copy of config that
# could drift from this one, and on 2026-08-10 it did: the secret still carried
# the retired GOOGLE_PLACES_KEY, so CI built an APK with a credential in it.
# One source of truth removes that failure mode. The release gate refuses any
# build whose keys file carries a credential, so this staying clean is enforced,
# not trusted. keys.pro.json remains ignored by the glob above.
!keys.free.json
.env
*.log

# Workspaces
# Separate repositories, checked out here only so one editor window covers
# everything. Each has its own remote and history; none of them belongs to this
# repo's tree.
cardcodex/
swipewise-backend/
swipewise-attic/
analysis/

# CCE (code-context-engine)
# CCE local cache (per-machine, not for version control)
.cce/
# Claude Code local settings written by cce init
.claude/settings.local.json
# .mcp.json contains absolute paths regenerated by `cce init`
.mcp.json
# .claude/settings.json holds cce hooks with absolute paths; regenerated by `cce init`
.claude/settings.json
# agent-ready.sh transients (proxy pidfile + log — per-run, machine-local)
.claude/.headroom-proxy
.claude/headroom-proxy.log
.github/copilot-instructions.md
# Claude Code subagent worktrees (local, transient — never tracked)
.claude/worktrees/
# ski skill
.ski

# Personal local tooling config (absolute home paths, useless to anyone else)
.codex/

# Release artifacts. Symbols are ~10MB per build and match exactly one binary,
# so they belong in wherever you archive releases, not in git. See docs/setup.md.
*-symbols.zip
*.aab
