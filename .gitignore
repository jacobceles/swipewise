cardcodex/
swipewise-attic/
analysis/

# CCE (code-context-engine)
# CCE local cache (per-machine, not for version control)
.cce/
# Claude Code local settings written by cce init
.claude/settings.local.json
# .mcp.json contains absolute paths regenerated by `cce init`
.mcp.json
# .claude/settings.json holds cce hooks with absolute paths; regenerated by `cce init`
.claude/settings.json
# agent-ready.sh transients (proxy pidfile + log — per-run, machine-local)
.claude/.headroom-proxy
.claude/headroom-proxy.log
.github/copilot-instructions.md
# Claude Code subagent worktrees (local, transient — never tracked)
.claude/worktrees/
