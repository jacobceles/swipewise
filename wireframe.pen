                  "type": "text",
                  "id": "z1lmLm",
                  "name": "Your Rights Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "You may request access to, correction of, or deletion of your personal data at any time. To exercise these rights, contact us at privacy@swipewise.app. We will respond to all requests within 30 business days.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
