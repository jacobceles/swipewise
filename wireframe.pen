                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "BvdWJ",
              "name": "How We Use Your Data Section",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "fJt8y",
                  "name": "How We Use Your Data Heading",
                  "fill": "$--foreground",
                  "content": "How We Use Your Data",
                  "fontFamily": "Inter",
                  "fontSize": 18,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "k9RIOj",
                  "name": "How We Use Your Data Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Your data is used to generate personalized spending breakdowns, recommend optimal credit cards for purchases, and provide financial insights. We never sell your personal information to third parties or use it for advertising purposes.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "SIncL",
              "name": "Data Security Section",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "cio7u",
                  "name": "Data Security Heading",
                  "fill": "$--foreground",
                  "content": "Data Security",
                  "fontFamily": "Inter",
                  "fontSize": 18,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "UbHPr",
                  "name": "Data Security Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "All financial data is encrypted in transit and at rest using AES-256 encryption. We use bank-level security protocols and undergo regular third-party security audits. Your credentials are never stored on our servers.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "OCDaY",
              "name": "Third-Party Services Section",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "AYL5I",
                  "name": "Third-Party Services Heading",
                  "fill": "$--foreground",
                  "content": "Third-Party Services",
                  "fontFamily": "Inter",
                  "fontSize": 18,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "nsetP",
                  "name": "Third-Party Services Body",
                  "fill": "$--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We partner with licensed financial data aggregators to securely access your transaction history. These partners are contractually bound to maintain the same level of data protection and cannot use your data independently.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
